# Database Credentials
# For local PostgreSQL:
# DB_USERNAME=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=cognilab

# For Supabase & Vercel Deployment:
# Option A: Direct Connection URL (recommended for Vercel Environment Variables)
# DATABASE_URL=postgresql+psycopg2://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-POOLER-HOST].pooler.supabase.com:5432/postgres?sslmode=require

# Option B: Individual Supabase variables
# DB_USERNAME=postgres.[YOUR-PROJECT-REF]
# DB_PASSWORD=your_supabase_password
# DB_HOST=[YOUR-POOLER-HOST].pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_SSLMODE=require

# Security & Tokens
JWT_SECRET=generate-a-secure-random-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=1440
